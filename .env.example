# このファイルを .env.local にコピーして値を埋める

# 使う AI の種類。gemini（既定）または openai-compatible（LM Studio・Ollama などのローカルサーバー）
AI_PROVIDER=gemini
# モデル ID。空なら gemini-3.8-flash。openai-compatible では必須で、サーバーの /v1/models が返す ID を書く
# 例: gemini-3.8-flash / qwen3.5-9b-uncensored-hauhaucs-aggressive-mlx
AI_MODEL=

# Gemini の API キー。AI_PROVIDER=gemini のときだけ必要（https://aistudio.google.com/apikey で発行）
GOOGLE_GENERATIVE_AI_API_KEY=
# OpenAI 互換サーバーの URL。空なら http://localhost:1234/v1（LM Studio）
# 例: Ollama は http://localhost:11434/v1
OPENAI_COMPATIBLE_BASE_URL=http://localhost:1234/v1
# OpenAI 互換サーバーの API キー。認証のないローカルサーバーなら空でよい
OPENAI_COMPATIBLE_API_KEY=
# 思考（thinking）の量。off / minimal / low / medium / high。空ならサーバーやモデルの既定
# Gemini 3 は思考を止められないので off は low 扱い。gemini-3.8-flash は minimal を受け付けない
# Qwen3.5 を LM Studio で動かす場合、off が効かないことがある。そのときは LM Studio 側のモデル設定で思考を切る
AI_THINKING=

# セッション署名用の秘密値。必須。例: openssl rand -base64 32 の出力
BETTER_AUTH_SECRET=
# アプリの URL。ローカルでは http://localhost:3000
BETTER_AUTH_URL=http://localhost:3000

# Mastra Platform と連携するときだけ使う。アプリ自体は参照しないので、ローカルで遊ぶだけなら空でよい
# アクセストークン（Mastra Platform で発行）
MASTRA_PLATFORM_ACCESS_TOKEN=
# Mastra Platform のプロジェクト ID（UUID）
MASTRA_PROJECT_ID=

# true で試合画面にデバッグパネルを出し、敵の次の手と判定ログを返す。通常は false
DEBUG_MODE=false

# Mastra の保存先（libsql の URL）。空なら <起動ディレクトリ>/data/mastra.db
# mastra dev（Studio）を別ターミナルで動かすときは、next dev と同じ DB を指すよう絶対パスで書く
# 例: file:/Users/you/pro-wrestling-chat/data/mastra.db / libsql://xxx.turso.io
TURSO_MASTRA_DATABASE_URL=
